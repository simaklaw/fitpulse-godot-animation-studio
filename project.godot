; FitPulse Animation Studio — pull-up motion prototype
; Godot 4.x project. Run scenes/pull_up_preview.tscn to preview.
config_version=5

[application]
config/name="FitPulse Pull-Up Motion Prototype"
run/main_scene="res://scenes/pull_up_preview.tscn"

[display]
window/size/viewport_width=720
window/size/viewport_height=720
window/size/window_width_override=720
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
