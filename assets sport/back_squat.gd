class_name BackSquatExercise
extends RefCounted
## Присед со штангой на спине (high-bar) — эталонное упражнение библиотеки.
##
## Техническая модель (числа проверены расчётом кинематики PoseSolver):
##   * Стопа неподвижна: высота таза и его сдвиг назад считаются из углов
##     бедра/колена — стопа не «плывёт» по полу.
##   * Голеностоп не задаётся вручную: он выводится из наклона голени так,
##     чтобы стопа оставалась плоской (пятка на полу).
##   * Корпус: наклон = наклон таза + поясница. Внизу 34° таза + 8° поясницы
##     = 42° от вертикали. Наклон даёт таз, а не скругление спины.
##   * Гриф идёт от Chest, поэтому едет вместе с корпусом; проверка баланса —
##     гриф над серединой стопы.
##
## Нижняя точка (расчёт): таз 0.372 м (60% глубины), колено 0.411 м — таз на
## 3.9 см НИЖЕ колена; сгибание колена 129°, тыльное сгибание стопы 34°,
## сгибание в ТБС 137°, колено на 7 см впереди носка.
##
## Профиль движения (почему фаз семь, а не «вниз-вверх»):
##   1. setup          — посадка в готовность, вдох, натяжение.
##   2. descent_top    — колени «ломаются» рано: таз не уезжает назад раньше
##                       времени, иначе гриф уходит за пятку.
##   3. descent_low    — основная эксцентрика в нижнюю точку.
##   4. bottom_pause   — пауза без баллистики: учит контролю (отскок — техника
##                       соревновательного приседа, для обучения не годится).
##   5. ascent_break   — мёртвая точка: старт почти нулевой скорости, затем
##                       разгон (ACCELERATE). Подъём разбит на две фазы, чтобы
##                       угловая скорость на стыке не рвалась.
##   6. ascent_finish  — вывод в стойку с торможением у фиксации.
##   7. lockout        — фиксация: колени почти прямые (5°), таз доведён.
##
## Темп 4.65 с на повтор (12.9 повт/мин) — тренировочный темп.
##
## Дыхание: вдох перед опусканием, задержка на весь повтор, выдох у фиксации.
## Это не декор: задержка создаёт внутрибрюшное давление и стабилизирует
## позвоночник под нагрузкой.

const STAND_THIGH := 2.0      ## угол бедра от вертикали в стойке, °
const STAND_KNEE := 5.0       ## колени почти прямые, но не «защёлкнуты»
const BOTTOM_THIGH := 95.0    ## бедро чуть выше горизонта → таз ниже колена
const BOTTOM_KNEE := 129.0    ## сгибание колена в нижней точке
const BOTTOM_PELVIS := 34.0   ## передний наклон таза внизу — даёт глубину и наклон
const BOTTOM_SPINE := 8.0     ## поясница почти нейтральна (порог 12°)
const BREAK_THIGH := 60.0     ## мёртвая точка: ~18° выше параллели
const BREAK_KNEE := 90.0
const BREAK_PELVIS := 30.0
const BREAK_SPINE := 9.0


static func build() -> ExerciseData:
	var data := ExerciseData.new()
	data.exercise_id = &"back_squat"
	data.display_name = "Присед со штангой"
	data.technique_kind = &"squat"
	data.equipment = "Штанга"
	data.animation_name = &"back_squat"
	# Гриф есть → риг должен его построить (has_barbell = true в сцене зала),
	# а PoseSolver — проверять баланс грифа над серединой стопы.
	data.has_bar = true
	data.loop = true
	data.default_tempo = 1.0

	data.description = "Базовое многосуставное упражнение: таз опускается между стоп, " \
		+ "колени идут по направлению носков, корпус сохраняет нейтральный позвоночник."

	data.muscles_primary = PackedStringArray([
		"Квадрицепс", "Большая ягодичная", "Приводящие мышцы бедра",
	])
	data.muscles_secondary = PackedStringArray([
		"Разгибатели спины", "Задняя поверхность бедра", "Мышцы кора", "Икроножные",
	])

	data.setup_cues = PackedStringArray([
		"Стопы на ширине плеч, носки развёрнуты на 15–20°",
		"Гриф лежит на трапециях, лопатки сведены, локти под грифом",
		"Вдох, живот в тонусе, спина без округления — «блок» до конца повтора",
		"Колени идут по направлению носков, вес — на середине стопы",
		"Внизу таз ниже колена, отскока нет",
	])

	data.common_mistakes = PackedStringArray([
		"Отрыв пятки: не хватает тыльного сгибания — шире стойка, носки наружу, " \
			+ "мобильность голеностопа или блины под пятку (сужать стойку бесполезно)",
		"Колени заваливаются внутрь: разводить их по носкам, не давать стопам разворачиваться",
		"Округление поясницы внизу (butt wink): не брать глубину больше доступной",
		"Смещение веса на носки: держать середину стопы, таз уходит назад, а не вперёд",
		"Отскок из нижней точки: пауза 0.3 с вместо баллистики сохраняет контроль",
	])

	# Поза до начала движения: стойка со штангой на спине.
	# Руки держат гриф УЖЕ здесь — иначе на замыкании цикла они «телепортируются»
	# с грифа вниз. Взятие грифа — отдельная вводная анимация приложения.
	# ВНИМАНИЕ: без IK кисти не прилегают к грифу точно (см. README, «Ограничения»).
	data.base_pose = PoseUtils.sym({
		&"thigh_angle": STAND_THIGH,
		&"knee_flexion": STAND_KNEE,
		&"pelvis_pitch": 6.0,
		&"spine_lean": 3.0,
		&"toe_out": 15.0,
		# --- хват грифа -----------------------------------------------------
		# Числа получены решением обратной задачи кинематики под точку грифа
		# (Chest-локально 0, 0.14, 0.07): центр ладони ложится на гриф с зазором
		# ~0.2 см, локоть при этом ниже плеча и отведён назад — как в реальном
		# хвате штанги на спине.
		#
		# Почему такие большие углы: без лопатки плечевой сустав остаётся на
		# месте и кисть до грифа не достаёт; scapula_lift поднимает плечо к уху
		# (это и есть реальное движение лопатки под нагрузкой), после чего
		# оставшийся путь добирается плечом и локтём.
		#
		# ВНИМАНИЕ: shoulder_twist 115° — это наружная ротация плеча, она
		# физиологична для хвата грифа сзади, но выглядит резко на низкополигональной
		# модели. Если понадобится «мягче», поднимайте scapula_lift и уменьшайте
		# shoulder_twist — решение не единственное (целое семейство, см. README).
		&"scapula_lift": 20.0,
		&"scapula_retraction": 0.0,
		&"shoulder_abduction": 35.0,
		&"shoulder_flexion": 5.0,
		&"shoulder_twist": 115.0,
		&"elbow_flexion": 140.0,
	})

	var phases = []

	# 1. Подготовка: посадка в готовность, вдох, натяжение.
	phases.append(_phase(
		&"setup", "Подготовка",
		"Стою с грифом, лопатки сведены, вдох, живот в тонусе",
		0.8, ExercisePhase.Ease.SMOOTH, &"inhale",
		{&"thigh_angle": 8.0, &"knee_flexion": 14.0, &"pelvis_pitch": 8.0, &"spine_lean": 4.0}
	))

	# 2. Начало опускания: колени сгибаются раньше таза. Если таз уходит назад
	#    первым, гриф уезжает за пятку — это и есть «присед на пятках».
	phases.append(_phase(
		&"descent_top", "Опускание: колени",
		"Сгибаю колени, таз идёт вниз-назад, стопы прижаты",
		0.7, ExercisePhase.Ease.SMOOTH, &"hold",
		{&"thigh_angle": 30.0, &"knee_flexion": 52.0, &"pelvis_pitch": 18.0, &"spine_lean": 7.0}
	))

	# 3. Основная эксцентрика: под весом разгоняется и тормозит у нижней точки.
	phases.append(_phase(
		&"descent_low", "Опускание: вниз",
		"Таз между стоп, колени по носкам, спина без округления",
		1.1, ExercisePhase.Ease.SMOOTH, &"hold",
		{
			&"thigh_angle": BOTTOM_THIGH,
			&"knee_flexion": BOTTOM_KNEE,
			&"pelvis_pitch": BOTTOM_PELVIS,
			&"spine_lean": BOTTOM_SPINE,
		}
	))

	# 4. Пауза внизу: контроль без отскока.
	phases.append(_phase(
		&"bottom_pause", "Пауза внизу",
		"Стоп: 0.3 с без отскока, вес на середине стопы",
		0.3, ExercisePhase.Ease.LINEAR, &"hold", {}
	))

	# 5. Мёртвая точка сразу над низом — самый тяжёлый участок: старт медленный.
	phases.append(_phase(
		&"ascent_break", "Проход мёртвой точки",
		"Толкаю пол всей стопой, колени и таз поднимаются одновременно",
		0.55, ExercisePhase.Ease.ACCELERATE, &"hold",
		{
			&"thigh_angle": BREAK_THIGH,
			&"knee_flexion": BREAK_KNEE,
			&"pelvis_pitch": BREAK_PELVIS,
			&"spine_lean": BREAK_SPINE,
		}
	))

	# 6. Выход в стойку с торможением у фиксации. Длительность подобрана так,
	#    чтобы угловая скорость на стыке с фазой 5 не прыгала.
	phases.append(_phase(
		&"ascent_finish", "Выпрямление",
		"Выдох у фиксации, колени выпрямляются, таз доведён",
		0.95, ExercisePhase.Ease.DECELERATE, &"exhale",
		{&"thigh_angle": STAND_THIGH, &"knee_flexion": STAND_KNEE,
			&"pelvis_pitch": 6.0, &"spine_lean": 3.0}
	))

	# 7. Фиксация: колени почти прямые, без гиперэкстензии и потери натяжения.
	phases.append(_phase(
		&"lockout", "Фиксация",
		"Колени почти прямые (5°), таз доведён, дыхание восстановлено",
		0.25, ExercisePhase.Ease.LINEAR, &"", {}
	))

	data.phases = phases
	return data


static func _phase(
	phase_id: StringName,
	label: String,
	cue: String,
	duration: float,
	ease: ExercisePhase.Ease,
	breath: StringName,
	pose: Dictionary
) -> ExercisePhase:
	var phase := ExercisePhase.new()
	phase.phase_id = phase_id
	phase.label = label
	phase.cue = cue
	phase.duration = duration
	phase.ease = ease
	phase.breath = breath
	# Парные каналы (thigh_angle, knee_flexion, ...) разворачиваются на обе ноги.
	phase.pose = PoseUtils.sym(pose)
	return phase
