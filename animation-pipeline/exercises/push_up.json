  "technique": {
    "setup": "High plank; palms are planted, hands approximately shoulder-width/just wider, shoulders over wrists, feet supported at the toes.",
    "cues": [
      "Head, thorax, pelvis and legs move as one controlled line.",
      "Elbows track about 30–60 degrees away from the torso, not straight out at 90 degrees.",
      "Wrists stay planted; the torso moves between stable hands and toes.",
      "Shoulder blades move naturally; avoid shrugging or collapsing into the shoulders."
    ],
    "common_errors": [
      "Pelvis drops or lifts independently of the chest.",
      "Elbows flare straight sideways.",
      "Head juts forward or drops independently.",
      "Hands or feet slide between frames; chest penetrates the floor."
    ],
    "breathing": "Inhale while lowering; exhale while pressing up.",
    "safety": "Use an incline or knee-supported version when a full push-up cannot be completed with a stable trunk. Range is limited by control, not by forcing the chest through the floor."
  },
  "phases": [
    {
      "id": "top_plank",
      "time": 0,
      "kind": "setup",
      "name": "High plank",
      "cue": "Stable hands and toes; head, trunk and legs form one line."
    },
    {
      "id": "lowering",
      "time": 0.27,
      "kind": "eccentric",
      "name": "Controlled lowering",
      "cue": "Chest lowers while elbows track back-and-out; pelvis stays aligned."
    },
    {
      "id": "bottom",
      "time": 0.5,
      "kind": "bottom",
      "name": "Bottom position",
      "cue": "Chest close to floor, no collapse or forced depth."
    },
    {
      "id": "pressing",
      "time": 0.82,
      "kind": "concentric",
      "name": "Press",
      "cue": "Drive through palms; trunk rises as one unit."
    },
    {
      "id": "top_return",
      "time": 1,
      "kind": "return",
      "name": "Return to plank",
      "cue": "Stable top position; loop seam returns to the same contacts."
    }
  ],
